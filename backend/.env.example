# Database Configuration
# For PostgreSQL with pgvector (recommended for production):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_inbox
# For lightweight local testing without PostgreSQL/pgvector:
# DATABASE_URL=sqlite+aiosqlite:///./ai_inbox.db

# AI Provider Configuration (Google Gemini or OpenAI)
# For Gemini (Recommended):
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_EMBEDDING_MODEL=text-embedding-004
OPENAI_CHAT_MODEL=gemini-1.5-flash
EMBEDDING_DIMENSION=768

# For OpenAI:
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini
# EMBEDDING_DIMENSION=1536

# Application Settings
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO
APP_ENV=development

# Optional Supabase / Auth configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json